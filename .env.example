# 复制为 .env 或在启动前 export
# 数据持久目录：容器部署时请指向宿主机挂载的持久卷，容器重建不丢失 auth.json 与任务工作区
DATA_DIR=/data
# opencode 凭据/模型存储位置（/connect 粘贴的 key 与模型选择）
XDG_CONFIG_HOME=/data/opencode-config
XDG_DATA_HOME=/data/opencode-data
# Web 服务
WEB_HOST=0.0.0.0
WEB_PORT=8080
# OpenCode Server 地址（容器内本机）
OPENCODE_URL=http://127.0.0.1:4096