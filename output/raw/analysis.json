    {
      "id": "TP-LOGIN-001",
      "requirementId": "REQ-LOGIN-001",
      "sourceSection": "第4节",
      "sourceSummary": "校验通过后创建登录会话并生成认证凭证，返回成功结果。",
      "module": "用户登录",
      "type": "正向",
      "name": "合法账号密码登录成功",
      "priority": "P0",
      "preconditions": [
        "用户已注册且账号状态正常",
        "账号密码符合需求规则"
      ],
      "testData": [
        "合法登录账号",
        "正确密码",
        "rememberMe=false"
      ],
      "trigger": "通过 HTTPS 提交 POST /api/auth/login 请求",
      "expected": [
        "HTTP 状态码为 200",
        "业务码为 0",
        "返回 accessToken、tokenType 和 expiresIn",
        "返回必要的用户基本信息且不包含密码、密码哈希、验证码或密钥",
        "建立与用户身份、会话和过期时间绑定的登录会话",
        "客户端保存认证凭证并跳转至原计划页面；无目标页面时跳转至首页"
      ],
      "postconditions": [
        "记录登录时间、客户端信息和成功结果的安全审计信息"
      ],
      "evidenceStatus": "原文明确",
      "status": "可直接生成用例",
      "gapIds": [],
      "remarks": ""
    },
